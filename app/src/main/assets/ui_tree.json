{
  "id": "screen_login",
  "path": "app.login",
  "type": "CONTAINER",
  "aestheticProperties": {
    "padding": 24.0,
    "backgroundColor": "#F5F5F5"
  },
  "children": [
    {
      "id": "title",
      "path": "app.login.title",
      "type": "TEXT",
      "aestheticProperties": {
        "text": "Inicia Sesión",
        "fontSize": 32.0,
        "textColor": "#212121",
        "paddingBottom": 8.0
      }
    },
    {
      "id": "subtitle",
      "path": "app.login.subtitle",
      "type": "TEXT",
      "aestheticProperties": {
        "text": "Bienvenido a tu aplicación controlada remotamente",
        "fontSize": 14.0,
        "textColor": "#757575",
        "paddingBottom": 32.0
      }
    },
    {
      "id": "input_email",
      "path": "app.login.input_email",
      "type": "INPUT",
      "aestheticProperties": {
        "placeholder": "Correo electrónico",
        "paddingBottom": 16.0
      },
      "logicDirectives": {
        "keyboardType": "email"
      }
    },
    {
      "id": "input_password",
      "path": "app.login.input_password",
      "type": "INPUT",
      "aestheticProperties": {
        "placeholder": "Contraseña",
        "paddingBottom": 32.0
      },
      "logicDirectives": {
        "isPassword": true
      }
    },
    {
      "id": "btn_submit",
      "path": "app.login.btn_submit",
      "type": "ACTION_EMITTER",
      "aestheticProperties": {
        "label": "Ingresar",
        "backgroundColor": "#6200EA",
        "textColor": "#FFFFFF"
      },
      "logicDirectives": {
        "action": "login_request"
      }
    }
  ]
}